rmal text-subheadline"><span>Printed p. 81 (PDF p. 87)</span></div></td></tr><tr class="border-color-(--fill-divider) border-t border-solid first:border-t-0"><td dir="auto" class="text-subheadline leading-[22px] text-text-primary py-2 px-4 text-start align-top break-words first:ps-0"><div dir="auto" class="[&amp;&gt;div]:mb-0 [&amp;&gt;div]:gap-0 [&amp;_*]:text-subheadline [&amp;_*]:font-medium break-normal text-subheadline-medium"><span>8.0 References — 83</span></div></td><td dir="auto" class="text-subheadline leading-[22px] text-text-primary py-2 px-4 text-start align-top break-words first:ps-0"><div dir="auto" class="[&amp;&gt;div]:mb-0 [&amp;&gt;div]:gap-0 [&amp;_*]:text-subheadline break-normal text-subheadline"><span>Printed p. 83 (PDF p. 89)</span></div></td></tr></tbody></table></div></div><div class="flex h-8 justify-end"><div class="contents"><button aria-label="Copy table" class="enabled:active:scale-98 inline-flex shrink-0 cursor-pointer items-center justify-center rounded-round focus:not-focus-visible:outline-none transition-transform duration-150 ease-in-out disabled:pointer-events-none disabled:opacity-50 select-none size-8 hover:enabled:bg-fill-secondary-elevated enabled:active:filter-[brightness(0.965)] dark:enabled:active:filter-[brightness(0.9)]" data-slot="tooltip-trigger" data-state="closed"><div class="relative"><div class=""><svg viewBox="0 0 32 32" fill="none" width="20" height="20" class="m-0.5"><path fill-rule="evenodd" clip-rule="evenodd" d="M17.3 10.125c-.826 0-1.497 0-2.041.044-.554.045-1.053.141-1.518.378a3.879 3.879 0 0 0-1.694 1.694c-.237.465-.333.964-.378 1.518-.045.544-.044 1.216-.044 2.04V22.2c0 .826 0 1.497.044 2.041.045.554.141 1.053.378 1.518.371.729.965 1.323 1.694 1.694.465.237.964.333 1.518.378.544.044 1.215.044 2.04.044H20.7c.826 0 1.497 0 2.041-.044.554-.045 1.053-.141 1.518-.378a3.879 3.879 0 0 0 1.694-1.694c.237-.465.333-.964.378-1.518.044-.544.044-1.215.044-2.04V15.8c0-.825 0-1.497-.044-2.041-.045-.554-.141-1.053-.378-1.518a3.879 3.879 0 0 0-1.694-1.694c-.465-.237-.964-.333-1.518-.378-.544-.045-1.215-.044-2.04-.044H17.3zm3.4 1.75c.855 0 1.443 0 1.9.038.445.037.688.103.865.193.4.204.725.53.929.93.09.176.157.418.193.864.037.457.038 1.045.038 1.9v6.4c0 .855 0 1.443-.038 1.9-.037.445-.103.688-.193.865-.204.4-.53.725-.93.929-.176.09-.418.157-.864.193-.457.037-1.045.038-1.9.038h-3.4c-.855 0-1.443 0-1.9-.038-.446-.037-.688-.103-.865-.193a2.126 2.126 0 0 1-.929-.93c-.09-.176-.156-.418-.193-.864-.037-.457-.038-1.045-.038-1.9v-6.4c0-.855 0-1.443.038-1.9.037-.446.103-.688.193-.865.204-.4.53-.725.93-.929.176-.09.418-.156.864-.193.457-.037 1.045-.038 1.9-.038h3.4z" fill="currentColor"></path><path d="M11.3 4.125c-.825 0-1.497 0-2.041.044-.554.045-1.053.141-1.518.378A3.879 3.879 0 0 0 6.047 6.24c-.237.465-.333.964-.378 1.518-.044.544-.044 1.215-.044 2.04V16.2c0 .826 0 1.497.044 2.041.045.554.141 1.053.378 1.518.371.729.965 1.323 1.694 1.694.465.237.964.333 1.518.378.117.01.241.016.37.021V20.1c-.08-.005-.156-.007-.229-.013-.445-.037-.688-.103-.865-.193a2.126 2.126 0 0 1-.929-.93c-.09-.176-.156-.418-.193-.864-.037-.457-.038-1.045-.038-1.9V9.8c0-.855 0-1.443.038-1.9.037-.445.103-.688.193-.865.204-.4.53-.725.93-.929.176-.09.419-.156.864-.193.457-.037 1.045-.038 1.9-.038h3.4c.855 0 1.443 0 1.9.038.445.037.688.103.865.193.4.204.725.53.929.93.09.176.157.419.193.864.006.073.01.15.014.23h1.752a10.24 10.24 0 0 0-.022-.371c-.045-.554-.141-1.053-.378-1.518a3.879 3.879 0 0 0-1.694-1.694c-.465-.237-.964-.333-1.518-.378-.544-.044-1.216-.044-2.04-.044H11.3z" fill="currentColor"></path></svg></div><svg viewBox="0 0 32 32" fill="none" width="20" height="20" class="pointer-events-none absolute inset-0 m-0.5 invisible"><path d="M24.285 7.542a.878.878 0 0 1 1.22-.21.868.868 0 0 1 .21 1.214l-12 16.912a.877.877 0 0 1-1.415.02l-6-7.958a.868.868 0 0 1 .175-1.22.879.879 0 0 1 1.225.175l5.279 7L24.285 7.542z" fill="currentColor"></path></svg><div class="pointer-events-none absolute inset-0 m-0.5 opacity-0"><div class="relative inline-block overflow-hidden" style="width: 20px; height: 20px;"><div class="absolute start-0 top-0" style="display: inline-block; line-height: 0; font-size: 0px; width: 20px; height: 20px; overflow: hidden;"><div style="position: relative; display: inline-block; box-sizing: border-box; padding: 0px; margin: 0px;"><canvas width="30" height="30" style="width: 20px; height: 20px;"></canvas></div></div></div></div></div></button></div></div></div></div></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack max-w-conversation mx-auto flex min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div><div class="prose prose-trimmed ur-markdown citation-aware"><div class="ur-sm mb-4 flex flex-col gap-6" style="--ur-sm-fade-duration: 150ms;"><p dir="auto">So <strong>do not renumber the TOC</strong>. The TOC itself is fine.</p><h2 dir="auto" class="mt-6 mb-2 font-semibold text-2xl">But the document is not submission-ready — 6 real problems</h2><h3 dir="auto" class="mt-6 mb-2 font-semibold text-xl">1. All screenshots are missing</h3><p dir="auto">This is the biggest issue. There is <strong>not a single screenshot</strong> in the whole file. The only 5 images in the document are the repeated header/footer/logo graphics.</p><ul dir="ltr" class="list-inside whitespace-normal [li_&amp;]:ps-6 list-disc"><li class="py-1 [&amp;&gt;p]:inline"><strong>4.1.5 Output Screenshot</strong> and <strong>4.2.5 Output Screenshot</strong>: just a heading, then the next module starts immediately. No placeholder, no image.</li><li class="py-1 [&amp;&gt;p]:inline"><strong>4.3.5, 4.4.5, 5.2, 6.3</strong>: still contain the literal placeholder text, e.g. “Insert screenshots of: Join Event Button / Successful Event Registration…”, “Insert screenshots from MongoDB showing: Students Collection…”, “Insert screenshots showing: Empty registration form validation…”</li></ul><p dir="auto">An examiner will see the placeholder instructions, not screenshots.</p><h3 dir="auto" class="mt-6 mb-2 font-semibold text-xl">2. 4.2.1 HTML Code has no HTML code</h3><p dir="auto">Under <strong>4.2.1 HTML Code</strong> there is only the intro sentence, then it jumps straight to <strong>4.2.2 CSS Code</strong>. The <code>events.html</code> code that belongs there is missing. (That same <code>events.html</code> code does appear later, under 4.3.1.)</p><h3 dir="auto" class="mt-6 mb-2 font-semibold text-xl">3. Degree name mismatch — fix this before submission</h3><ul dir="ltr" class="list-inside whitespace-normal [li_&amp;]:ps-6 list-disc"><li class="py-1 [&amp;&gt;p]:inline"><strong>Title page:</strong> “BACHELOR OF SCIENCE (BSc) — Computer Science, Mathematics”</li><li class="py-1 [&amp;&gt;p]:inline"><strong>Certificate (p. 2):</strong> “…Bachelor of Science (Computer Science, <strong>Electronics and Physics</strong>) degree…”</li></ul><p dir="auto">These contradict each other. One of them is wrong.</p><h3 dir="auto" class="mt-6 mb-2 font-semibold text-xl">4. Front-matter pagination / layout is untidy</h3><ul dir="ltr" class="list-inside whitespace-normal [li_&amp;]:ps-6 list-disc"><li class="py-1 [&amp;&gt;p]:inline">Pages 1–6 (title → TOC) have <strong>no printed page numbers</strong> and inconsistent headers/footers, while the body starts numbering at 1. That part is normal, but:</li><li class="py-1 [&amp;&gt;p]:inline"><strong>Synopsis and Table of Contents share the same page</strong> (PDF p. 5), and the TOC then spills onto PDF p. 6. The TOC should start on a fresh page.</li><li class="py-1 [&amp;&gt;p]:inline">Chapters do <strong>not</strong> start on a new page. E.g. 1.0, 2.0, 3.0, 4.0 all run on continuously, so headings land mid-page.</li></ul><h3 dir="auto" class="mt-6 mb-2 font-semibold text-xl">5. A typo inside the code</h3><p dir="auto">In <strong>4.4.2 CSS Code</strong>, in the <code>.hero h1</code> block:</p></div></div></div></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack max-w-conversation mx-auto flex min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div class="ur-sm-fade"><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Code</span></div><div class="ur-code-block__header-right"><div class="contents"><button aria-label="Copy response" class="enabled:active:scale-98 inline-flex shrink-0 cursor-pointer items-center justify-center rounded-round focus:not-focus-visible:outline-none transition-transform duration-150 ease-in-out disabled:cursor-not-allowed disabled:opacity-50 select-none size-7 hover:enabled:bg-fill-secondary-elevated enabled:active:filter-[brightness(0.965)] dark:enabled:active:filter-[brightness(0.9)] text-text-secondary" data-slot="tooltip-trigger" data-state="closed"><div class="relative"><div class=""><svg viewBox="0 0 24 24" fill="currentColor" width="1em" height="1em" class="m-0.5" size="20"><path fill-rule="evenodd" clip-rule="evenodd" d="M5 14h1v2H5a3 3 0 0 1-3-3V5a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v1h-2V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1zm14 6h-8a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1zm3-1a3 3 0 0 1-3 3h-8a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v8z"></path></svg></div><svg viewBox="0 0 32 32" fill="none" width="20" height="20" class="pointer-events-none absolute inset-0 m-0.5 invisible"><path d="M24.285 7.542a.878.878 0 0 1 1.22-.21.868.868 0 0 1 .21 1.214l-12 16.912a.877.877 0 0 1-1.415.02l-6-7.958a.868.868 0 0 1 .175-1.22.879.879 0 0 1 1.225.175l5.279 7L24.285 7.542z" fill="currentColor"></path></svg><div class="pointer-events-none absolute inset-0 m-0.5 opacity-0"><div class="relative inline-block overflow-hidden" style="width: 20px; height: 20px;"><div class="absolute start-0 top-0" style="display: inline-block; line-height: 0; font-size: 0px; width: 20px; height: 20px; overflow: hidden;"><div style="position: relative; displa