tent-sin11-2.xx.fbcdn.net\u0026_nc_ohc=TlUkflqPNy8Q7kNvwFDdBPB\u0026stp=s325x325_tt6\u0026ccb=17-1\u0026_nc_gid=JjdU0UrQPam67sg23QM5iQ\u0026_nc_ss=7b289\u0026_nc_zt=14\u0026oh=00_AQTD2XXML6ineCgMVqbnPREV6suebjGLSdz9js9rf_NP8A\u0026oe=6B18E9C7\",\"squareThumbnailUri\":\"https://scontent-sin11-2.xx.fbcdn.net/o1/v/t6/f2/m421/AQP76htt_vhCxxsPGKFHQ0N322bR1x6NqG7o0e3Ooc448gRbxeVRCxTU0q82j-z3ZZVKJodDJEtnCtcvnUoe8QpW.gif?_nc_cat=101\u0026_nc_sid=5b3566\u0026_nc_ht=scontent-sin11-2.xx.fbcdn.net\u0026_nc_ohc=TlUkflqPNy8Q7kNvwFDdBPB\u0026stp=s325x325_tt6\u0026ccb=17-1\u0026_nc_gid=JjdU0UrQPam67sg23QM5iQ\u0026_nc_ss=7b289\u0026_nc_zt=14\u0026oh=00_AQTD2XXML6ineCgMVqbnPREV6suebjGLSdz9js9rf_NP8A\u0026oe=6B18E9C7\",\"placeholderThumbnailUri\":\"https://scontent-sin11-1.xx.fbcdn.net/o1/v/t6/f2/m421/AQOV2gD56NOpRHWjfDElFDZAk5NZVTMpqgU1JMBfawgcZ5-BdFF6BpAp2FblC_VzcYFvW8pgHgMr5e7YBXhC3b5m.jpg?_nc_cat=105\u0026_nc_sid=5b3566\u0026_nc_ht=scontent-sin11-1.xx.fbcdn.net\u0026_nc_ohc=1fPjRQokjXUQ7kNvwHje-2F\u0026stp=s325x325_tt6\u0026ccb=17-1\u0026_nc_gid=JjdU0UrQPam67sg23QM5iQ\u0026_nc_zt=14\u0026_nc_ss=7b289\u0026oh=00_AQTDqEs_BVsr0tz_WJ59CbbemPTjm_sqecXplPpoUrb7rA\u0026oe=6B18E193\",\"capabilities\":[\"IMAGINE\"],\"isVideo\":false,\"category\":\"image\",\"attachmentType\":\"MEDIA_PICKER\",\"multipleAttachments\":false,\"suggestedAttachmentCount\":null,\"mediaPickerSubtitle\":null,\"promptText\":\"Make a GIF of a close-up shot of someone with different styles\",\"segments\":[{\"type\":\"static\",\"text\":\"Make a GIF of a close-up shot of someone with different styles\"}],\"userInputSteps\":[{\"stepType\":\"IMAGE_PICKER\",\"suggestedMediaCount\":null,\"textSuggestions\":[],\"detailedSuggestions\":[],\"mediaSuggestions\":[],\"title\":\"Choose an image\"}]}]\n"])</script><script nonce="">self.__next_f.push([1,"11b:T482,Edit the attached photo. Restyle this image by maintaining the subject's face and likeness to be recognizable. Dramatically transform EVERYTHING else — drench the entire scene in bold, cinematic, hyper-stylized visual transformation to the lighting, colors, environment, and atmosphere around the subject. The subject presides over an absurdist cereal wonderland where giant cereal boxes form towering pyramids reaching toward a milk-white sky, while Cheerios the size of tires roll past like tumbleweeds across the surreal landscape. A magnificent waterfall of colorful cereal pieces cascades behind them, creating a rainbow river that flows through this breakfast paradise. The entire scene bathes in hyper-saturated commercial lighting reminiscent of 1950s advertising but pushed to absurd extremes. The subject wears a flowing ceremonial robe woven from chains of oversized Fruit Loops, crowned with an elaborate headdress of various breakfast cereals, with milk-splash accessories that catch the nostalgic lighting. The atmosphere captures the bright, optimistic energy of vintage breakfast commercials transformed into an epic mythological realm.ff:{\"data\":{\"conversationStartersByType\":[{\"id\":\"1047742257774387\",\"text\":\"Make an isometric 3D diorama of my room\",\"longPrompt\":\"Create an Isometric 3D diorama image of this uploaded room photo, orthographic, no perspective. Stylized toy-like, soft matte felt/wood, rounded, low-poly smooth. Warm diffuse light, AO. Not photorealistic. White background, centered.\",\"type\":\"imagine_media_picker\",\"attachment_type\":\"MEDIA_PICKER\",\"category\":null,\"responseDisplayMode\":null},{\"id\":\"1479983440319414\",\"text\":\"Restyle my photo as a surreal breakfast cereal champ\",\"longPrompt\":\"$11b\",\"type\":\"imagine_media_picker\",\"attachment_type\":\"MEDIA_PICKER\",\"category\":null,\"responseDisplayMode\":null},{\"id\":\"1661338771653306\",\"text\":\"Apply photo restoration to this photo\",\"longPrompt\":\"Take the user supplied photo and restore it to modern quality: remove scratches, fix color, sharpen faces, etc.\",\"type\":\"imagine_media_picker\",\"attachment_type\":\"MEDIA_PICKER\",\"category\":null,\"responseDisplayMode\":null},{\"id\":\"1602379481031442\",\"text\":\"Help me build a website\",\"longPrompt\":\"I want to build a website but don't know where to start. Help me figure out the best way to get going.\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"PLAN\",\"responseDisplayMode\":\"full_prompt\"}]}}\n"])</script><next-route-announcer style="position: absolute;" data-aria-hidden="true" aria-hidden="true"><template shadowrootmode="open"><div aria-live="assertive" id="__next-route-announcer__" role="alert" style="position: absolute; border: 0px; height: 1px; margin: -1px; padding: 0px; width: 1px; clip: rect(0px, 0px, 0px, 0px); overflow: hidden; white-space: nowrap; overflow-wrap: normal;"></div></template></next-route-announcer><script nonce="">$RC("B:f","S:f")</script><script nonce="">self.__next_f.push([1,"10c:{\"data\":{\"mainChat\":null,\"pinnedConversations\":{\"edges\":[],\"pageInfo\":{\"endCursor\":null,\"hasNextPage\":false}},\"unpinnedConversations\":{\"edges\":[{\"node\":{\"id\":\"3f09e197-243c-4985-91db-0ab4bf902010\",\"__typename\":\"Conversation\",\"updatedAt\":\"2026-11-09T07:24:18.000Z\",\"lastSendMessageTimestampMs\":1794209058113,\"conversationId\":\"3f09e197-243c-4985-91db-0ab4bf902010\",\"isPersisted\":true,\"title\":\"Fixing code spacing and TOC\",\"displayTitle\":\"Fixing code spacing and TOC\",\"isMainChat\":false,\"viewerActions\":[\"CAN_PIN\",\"CAN_RENAME\",\"DELETE\",\"CREATE_SNAPSHOT_LINK\",\"DELETE_SNAPSHOT_LINK\"],\"pinned\":false,\"isUnread\":false,\"wearableSurface\":null,\"matchingSnippet\":null,\"matchingSnippets\":null,\"type\":\"CHAT\"},\"cursor\":\"MA==\"}],\"pageInfo\":{\"endCursor\":\"MA==\",\"hasNextPage\":false}}}}\n"])</script><script nonce="">$RC("B:15","S:15")</script><script nonce="">self.__next_f.push([1,"101:{\"data\":{\"conversationStartersByType\":[{\"id\":\"1047742257774387\",\"text\":\"Make an isometric 3D diorama of my room\",\"longPrompt\":\"Create an Isometric 3D diorama image of this uploaded room photo, orthographic, no perspective. Stylized toy-like, soft matte felt/wood, rounded, low-poly smooth. Warm diffuse light, AO. Not photorealistic. White background, centered.\",\"type\":\"imagine_media_picker\",\"attachment_type\":\"MEDIA_PICKER\",\"category\":null,\"responseDisplayMode\":null},{\"id\":\"1713408529786757\",\"text\":\"GIF me 16 different haircuts\",\"longPrompt\":\"Create a gif of me in a static portrait pose, cycling through 16 different haircut styles.\",\"type\":\"imagine\",\"attachment_type\":\"NONE\",\"category\":null,\"responseDisplayMode\":null},{\"id\":\"1661338771653306\",\"text\":\"Apply photo restoration to this photo\",\"longPrompt\":\"Take the user supplied photo and restore it to modern quality: remove scratches, fix color, sharpen faces, etc.\",\"type\":\"imagine_media_picker\",\"attachment_type\":\"MEDIA_PICKER\",\"category\":null,\"responseDisplayMode\":null},{\"id\":\"1437611004920080\",\"text\":\"Make a birthday card\",\"longPrompt\":\"Copy the style, colors and layout of the reference image exactly. Make the person in the supplied photo the main subject. keep their face, hair, features and their own clothing clearly recognizable, rendered with the same technique and materials as the person in the first image. If the uploaded photo contains more than one person, include every person and every pet from that photo in the output. Write all text from the reference image in the same language the user wrote their request in, keeping the same wording, font, style and position.\",\"type\":\"imagine\",\"attachment_type\":\"NONE\",\"category\":null,\"responseDisplayMode\":null}]}}\n"])</script><script nonce="">$RC("B:11","S:11")</script><div role="dialog" id="radix-_r_gc_" aria-labelledby="radix-_r_gd_" data-state="open" class="fixed inset-0 z-50 outline-none data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0" tabindex="-1" style="pointer-eve